[05/04 12:47:13    150s]     set procname [dict get [info frame [info frame]] proc]
[05/04 12:47:13    150s]     set ARGS(-output) "log"
[05/04 12:47:13    150s]     parse_proc_arguments -args $args ARGS
[05/04 12:47:13    150s]     switch $ARGS(-output) {
[05/04 12:47:13    150s]         "log" {interp alias {} write_cmd {} puts}
[05/04 12:47:13    150s]         "logv" {interp alias {} write_cmd {} vputs}
[05/04 12:47:13    150s]         "stdout" {interp alias {} write_cmd {} puts}
[05/04 12:47:13    150s]         default {error}
[05/04 12:47:13    150s]     }
[05/04 12:47:13    150s]     ## listup ccopt cell naming
[05/04 12:47:13    150s]     redirect -variable show_ccopt_cell_name_info_result {puts [report_cts_cell_name_info]}
[05/04 12:47:13    150s]     set cell_prefix_list ""
[05/04 12:47:13    150s]     foreach line [split $show_ccopt_cell_name_info_result "\n"] {
[05/04 12:47:13    150s]         if {[regexp {Creators:} $line]} {continue}
[05/04 12:47:13    150s]         if {[lindex $line 0] != ""} {lappend cell_prefix_list "[get_db cts_inst_name_prefix]_[lindex $line 0]"}
[05/04 12:47:13    150s]     }
[05/04 12:47:13    150s]     if {[info exists ARGS(-clock_trees)]} {
[05/04 12:47:13    150s]         set effective_clock_trees ""
[05/04 12:47:13    150s]         foreach i $ARGS(-clock_trees) {
[05/04 12:47:13    150s]             if {[get_ccopt_clock_trees $ARGS(-clock_trees)] == ""} {
[05/04 12:47:13    150s]                 puts "WARN($procname): specified clock_tree $ARGS(-clock_tree) not found, ignore"
[05/04 12:47:13    150s]             } else {
[05/04 12:47:13    150s]                 lappend effective_clock_trees $i
[05/04 12:47:13    150s]             }
[05/04 12:47:13    150s]         }
[05/04 12:47:13    150s]         if {$effective_clock_trees == ""} {
[05/04 12:47:13    150s]             puts "ERROR($procname): no effective clock_trees found, exit"
[05/04 12:47:13    150s]             return
[05/04 12:47:13    150s]         }
[05/04 12:47:13    150s]        set all_clock_tree_insts [get_db clock_tree:$effective_clock_trees .insts.name ]
[05/04 12:47:13    150s]        set all_clock_tree_sinks [ get_db clock_tree:$effective_clock_trees .sinks.name ]
[05/04 12:47:13    150s]     } else {
[05/04 12:47:13    150s]         set effective_clock_trees "all"
[05/04 12:47:13    150s] 	set all_clock_tree_insts [get_db clock_trees .insts.name]
[05/04 12:47:13    150s]         set all_clock_tree_sinks [get_db clock_trees .sinks.name]
[05/04 12:47:13    150s]             }
[05/04 12:47:13    150s]     set total_num_insts [llength $all_clock_tree_insts]
[05/04 12:47:13    150s]     set counter 0
[05/04 12:47:13    150s]     foreach i $all_clock_tree_insts {
[05/04 12:47:13    150s]         set cell [get_db [get_db inst:$i] .base_cell.name]
[05/04 12:47:13    150s]         set prefix "OTHER"
[05/04 12:47:13    150s]         foreach j $cell_prefix_list {
[05/04 12:47:13    150s]             if {[string match *$j* $i]} {
[05/04 12:47:13    150s]                 set prefix $j
[05/04 12:47:13    150s]                 break
[05/04 12:47:13    150s]             }
[05/04 12:47:13    150s]         }
[05/04 12:47:13    150s]         incr STAT_CCOPT($cell,$prefix)
[05/04 12:47:13    150s]         incr counter
[05/04 12:47:13    150s]         puts -nonewline "\r processing  $counter / $total_num_insts"
[05/04 12:47:13    150s]  flush stdout
[05/04 12:47:13    150s]     }
[05/04 12:47:13    150s]     puts ""
[05/04 12:47:13    150s]     set prop_cell_list ""
[05/04 12:47:13    150s]     set cell_buf_list ""
[05/04 12:47:13    150s]        foreach i [get_db cts_buffer_cells] {
[05/04 12:47:13    150s]          foreach j [get_db base_cells .name $i] {
[05/04 12:47:13    150s]              lappend cell_buf_list $j
[05/04 12:47:13    150s]              lappend prop_cell_list $j
[05/04 12:47:13    150s]         }
[05/04 12:47:13    150s]      }
[05/04 12:47:13    150s]     set cell_inv_list ""
[05/04 12:47:13    150s]          foreach i [get_db cts_inverter_cells] {
[05/04 12:47:13    150s]          foreach j [get_db base_cells .name $i] {
[05/04 12:47:13    150s]              lappend cell_inv_list $j
[05/04 12:47:13    150s]              lappend prop_cell_list $j
[05/04 12:47:13    150s]          }        
[05/04 12:47:13    150s]      }
[05/04 12:47:13    150s]     set cell_oth_list ""
[05/04 12:47:13    150s]         foreach i [get_db cts_clock_gating_cells] {
[05/04 12:47:13    150s]          foreach j [get_db base_cells .name $i] {
[05/04 12:47:13    150s]              lappend cell_oth_list $j
[05/04 12:47:13    150s]              lappend prop_cell_list $j
[05/04 12:47:13    150s]          }
[05/04 12:47:13    150s]      }
[05/04 12:47:13    150s]     set prop_cell_ulist [lsort -unique $prop_cell_list]
[05/04 12:47:13    150s]     set prefix_list ""
[05/04 12:47:13    150s]     set value_list ""
[05/04 12:47:13    150s]     foreach i [array names STAT_CCOPT] {
[05/04 12:47:13    150s]         if {[regexp {(\S+)\,(\S+)} $i matchVar cell prefix]} { 
[05/04 12:47:13    150s]              if {[get_db [get_db base_cell:$cell  ] .is_buffer]} {
[05/04 12:47:13    150s]                  lappend cell_buf_list $cell
[05/04 12:47:13    150s]              } elseif {[get_db [get_db base_cell:$cell ] .is_inverter]} {
[05/04 12:47:13    150s]                  lappend cell_inv_list $cell
[05/04 12:47:13    150s]              } else {
[05/04 12:47:13    150s]                  lappend cell_oth_list $cell
[05/04 12:47:13    150s]              }
[05/04 12:47:13    150s]             lappend prefix_list $prefix
[05/04 12:47:13    150s]             lappend value_list $STAT_CCOPT($i)
[05/04 12:47:13    150s]         } else {
[05/04 12:47:13    150s]             error "unexpected array prefix_listnames $i"
[05/04 12:47:13    150s]         }
[05/04 12:47:13    150s]     }
[05/04 12:47:13    150s]     set cell_buf_ulist [lsort -unique $cell_buf_list]
[05/04 12:47:13    150s]     set cell_inv_ulist [lsort -unique $cell_inv_list]
[05/04 12:47:13    150s]     set cell_oth_ulist [lsort -unique $cell_oth_list]
[05/04 12:47:13    150s]     set prefix_ulist   [lsort -unique $prefix_list]
[05/04 12:47:13    150s]     write_cmd "### \[\[ clock_tree(s) tree stats : $effective_clock_trees (# of sinks = [llength $all_clock_tree_sinks]) \]\] ###"
[05/04 12:47:13    150s]     set max_cell_string_length 0
[05/04 12:47:13    150s]     foreach i [concat $cell_buf_ulist $cell_inv_ulist $cell_oth_ulist "TOTAL"] {
[05/04 12:47:13    150s]         if {[string length $i] > $max_cell_string_length} {
[05/04 12:47:13    150s]             set max_cell_string_length [string length $i]
[05/04 12:47:13    150s]         }
[05/04 12:47:13    150s]     }
[05/04 12:47:13    150s]     set max_result_string_length 0
[05/04 12:47:13    150s]     foreach i [concat $prefix_ulist $value_list "TOTAL"] {
[05/04 12:47:13    150s]         if {[string length $i] > $max_result_string_length} {
[05/04 12:47:13    150s]             set max_result_string_length [string length $i]
[05/04 12:47:13    150s]         }
[05/04 12:47:13    150s]     }
[05/04 12:47:13    150s]     set lenc [expr $max_cell_string_length + 2]
[05/04 12:47:13    150s]     set lenr [expr $max_result_string_length + 1]
[05/04 12:47:13    150s]     ## prepare real final_col_key / row_key
[05/04 12:47:13    150s]     if {[info exists ARGS(-keep_empty)]} {
[05/04 12:47:13    150s]         set row_keys [concat $cell_buf_ulist $cell_inv_ulist $cell_oth_ulist]
[05/04 12:47:13    150s]     } else {
[05/04 12:47:13    150s]         set row_keys ""
[05/04 12:47:13    150s]         foreach i [concat $cell_buf_ulist $cell_inv_ulist $cell_oth_ulist] {
[05/04 12:47:13    150s]             foreach j [array names STAT_CCOPT $i,*] {
[05/04 12:47:13    150s]                 if {$STAT_CCOPT($j) > 0} {
[05/04 12:47:13    150s]                     lappend row_keys $i
[05/04 12:47:13    150s]                     break
[05/04 12:47:13    150s]                 }
[05/04 12:47:13    150s]             }
[05/04 12:47:13    150s]         }
[05/04 12:47:13    150s]     }
[05/04 12:47:13    150s]     set col_keys $prefix_ulist
[05/04 12:47:13    150s]     ## write
[05/04 12:47:13    150s]     # fisrt row
[05/04 12:47:13    150s]     write_cmd -nonewline "|[format "%${lenc}s" ""]"
[05/04 12:47:13    150s]     set avoid_dup ""
[05/04 12:47:13    150s]     foreach i $col_keys {
[05/04 12:47:13    150s]         if {[lsearch $avoid_dup $i] > -1} {continue}
[05/04 12:47:13    150s]         write_cmd -nonewline "|[format "%${lenr}s"  $i]"
[05/04 12:47:13    150s]         lappend avoid_dup $i
[05/04 12:47:13    150s]     }
[05/04 12:47:13    150s]     write_cmd "|[format "%${lenr}s" "TOTAL"]|"
[05/04 12:47:13    150s]     # second row
[05/04 12:47:13    150s]     write_cmd -nonewline "+[string repeat "-" ${lenc}]"
[05/04 12:47:13    150s]     set avoid_dup ""
[05/04 12:47:13    150s]     foreach i $col_keys {
[05/04 12:47:13    150s]         if {[lsearch $avoid_dup $i] > -1} {continue}
[05/04 12:47:13    150s]         write_cmd -nonewline "+[string repeat "-" ${lenr}]"
[05/04 12:47:13    150s]         lappend avoid_dup $i
[05/04 12:47:13    150s]     }
[05/04 12:47:13    150s]     write_cmd "+[string repeat "-" ${lenr}]+"
[05/04 12:47:13    150s]     # middle row
[05/04 12:47:13    150s]     set avoid_dup ""
[05/04 12:47:13    150s]     foreach i $row_keys {
[05/04 12:47:13    150s]         if {[lsearch $avoid_dup $i] > -1} {continue}
[05/04 12:47:13    150s]         if {[lsearch $prop_cell_ulist $i] > -1} {
[05/04 12:47:13    150s]             write_cmd -nonewline "|[format "%${lenc}s" "@:$i"]"
[05/04 12:47:13    150s]         } else {
[05/04 12:47:13    150s]             write_cmd -nonewline "|[format "%${lenc}s" $i]"
[05/04 12:47:13    150s]         }
[05/04 12:47:13    150s]         set row_total 0
[05/04 12:47:13    150s]         foreach j $col_keys {
[05/04 12:47:13    150s]             if {[info exists STAT_CCOPT($i,$j)]} {
[05/04 12:47:13    150s]                 write_cmd -nonewline "|[format "%${lenr}s" $STAT_CCOPT($i,$j)]"
[05/04 12:47:13    150s]                 incr row_total $STAT_CCOPT($i,$j)
[05/04 12:47:13    150s]             } else {
[05/04 12:47:13    150s]                 write_cmd -nonewline "|[format "%${lenr}s" "0"]"
[05/04 12:47:13    150s]             }
[05/04 12:47:13    150s]         }
[05/04 12:47:13    150s]         write_cmd "|[format "%${lenr}s" $row_total]|"
[05/04 12:47:13    150s]         lappend avoid_dup $i
[05/04 12:47:13    150s]     }
[05/04 12:47:13    150s]     # before last row
[05/04 12:47:13    150s]     write_cmd -nonewline "+[string repeat "-" ${lenc}]"
[05/04 12:47:13    150s]     set avoid_dup ""
[05/04 12:47:13    150s]     foreach i $col_keys {
[05/04 12:47:13    150s]         if {[lsearch $avoid_dup $i] > -1} {continue}
[05/04 12:47:13    150s]         write_cmd -nonewline "+[string repeat "-" ${lenr}]"
[05/04 12:47:13    150s]         lappend avoid_dup $i
[05/04 12:47:13    150s]     }
[05/04 12:47:13    150s]     write_cmd "+[string repeat "-" ${lenr}]+"
[05/04 12:47:13    150s]     # last row
[05/04 12:47:13    150s]     write_cmd -nonewline "|[format "%${lenc}s" "TOTAL"]"
[05/04 12:47:13    150s]     set avoid_dup ""
[05/04 12:47:13    150s]     set total_total 0
[05/04 12:47:13    150s]     foreach i $col_keys {
[05/04 12:47:13    150s]         if {[lsearch $avoid_dup $i] > -1} {continue}
[05/04 12:47:13    150s]         set col_total 0
[05/04 12:47:13    150s]         foreach j [array names STAT_CCOPT *,$i] {
[05/04 12:47:13    150s]             incr col_total $STAT_CCOPT($j)
[05/04 12:47:13    150s]         }
[05/04 12:47:13    150s]         write_cmd -nonewline "|[format "%${lenr}s" $col_total]"
[05/04 12:47:13    150s]         lappend avoid_dup $i
[05/04 12:47:13    150s]         incr total_total $col_total
[05/04 12:47:13    150s]     }
[05/04 12:47:13    150s]     write_cmd "|[format "%${lenr}s" $total_total]|"
[05/04 12:47:13    150s] }
[05/04 12:47:13    150s] @file 194:
[05/04 12:47:13    150s] @file 195: # logCommand user_statCCOpt
[05/04 12:47:13    150s] @@file 196: define_proc_arguments user_statCCOpt  \
[05/04 12:47:13    150s] -info "report overview of CCOpt cell name code usage"  \
[05/04 12:47:13    150s] -define_args { {-clock_trees "specify clock_trees to report cell name code usage
[05/04 12:47:13    150s]  if not specified, all clock_tree are checked" "" string optional}
[05/04 12:47:13    150s]         {-keep_empty "display empty col/row
[05/04 12:47:13    150s]  default=empty col/row is not printed" "" boolean optional}
[05/04 12:47:13    150s]         {-output "output command
[05/04 12:47:13    150s]  default=log" "" one_of_string {optional value_help {values "log logv stdout"}}}
[05/04 12:47:13    150s]     }
